# Runtime environment: Dev or Prod
APP_ENV=Dev

# Server port (1-65535)
APP_PORT=5001

# Comma-separated browser origins allowed to call the API.
# Leave empty to disable cross-origin browser requests.
CORS_ORIGINS=http://localhost:3000

# Rate limit applied to /api: 100 requests in 15 minutes by default.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
